// Hosts and their tables are seeded (prisma/seed.ts); there is no UI to manage them.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CardStatus {
  NOT_SENT
  SENT
  FAILED
}

enum SupportIssueType {
  CARD_NOT_RECEIVED
  UNABLE_TO_REGISTER
  DETAILS_INCORRECT
  OTHER
}

enum SupportRequestStatus {
  OPEN
  RESOLVED
}

model Host {
  id                String  @id
  name              String
  /// Every guest the host may bring: always its tables' seats added up (lib/data/host-admin.ts keeps it so).
  capacity          Int
  acceptingRequests Boolean @default(true) @map("accepting_requests")
  tables            Table[]
  guests            Guest[]

  @@map("hosts")
}

/// Event-wide settings: one row (id 1). Seeded, and editable on /admin/hosts.
model EventSettings {
  id            Int      @id @default(1)
  maxTables     Int      @map("max_tables")
  seatsPerTable Int      @map("seats_per_table")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_settings")
}

/// How a table's guests get their access cards.
enum AccessCardType {
  PHYSICAL
  DIGITAL
}

model Table {
  /// Unique across the event, so a number always means one physical table.
  number   Int            @id
  capacity Int
  /// PHYSICAL tables count as full; approvals and moves only use DIGITAL ones. Admins can switch it.
  cardType AccessCardType @default(DIGITAL) @map("card_type")
  /// Null while the table isn't given to any host.
  hostId   String?        @map("host_id")
  host     Host?          @relation(fields: [hostId], references: [id], onDelete: Restrict)
  guests   Guest[]

  @@index([hostId])
  @@map("tables")
}

model Guest {
  id               String      @id @default(uuid()) @db.Uuid
  /// Exactly as the guest (or admin) entered it; printed on the access card.
  name             String
  /// Lowercase alphanumerics of `name`, used only for duplicate detection. Admins may create
  /// guests with the same name, so a numeric suffix keeps it unique ("janedoe", "janedoe2"…).
  normalizedName   String      @unique @map("normalized_name")
  email            String
  invitedBy        String      @map("invited_by")
  host             Host        @relation(fields: [invitedBy], references: [id], onDelete: Restrict)
  status           GuestStatus @default(PENDING)
  /// One of the host's tables. Required while APPROVED (CHECK constraint).
  tableNumber      Int?        @map("table_number")
  table            Table?      @relation(fields: [tableNumber], references: [number], onDelete: Restrict)
  cardStatus       CardStatus  @default(NOT_SENT) @map("card_status")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt       DateTime?   @map("approved_at") @db.Timestamptz(3)
  cardSentAt       DateTime?   @map("card_sent_at") @db.Timestamptz(3)
  cancelledAt      DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  checkInToken     String?     @unique @map("check_in_token")
  checkedInAt      DateTime?   @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy      String?     @map("checked_in_by")
  checkedInByAdmin User?       @relation("CheckedInBy", fields: [checkedInBy], references: [id], onDelete: Restrict)

  // Capacity and occupancy are derived from APPROVED rows per host and per table.
  @@index([email])
  @@index([invitedBy, status])
  @@index([status, tableNumber])
  @@index([status, checkedInAt])
  @@map("guests")
}

/// A message sent from the public "Need help?" form. Deliberately not linked to
/// a guest: the sender may not have registered, and the form must never reveal
/// whether a name or email exists.
model InvitationSupportRequest {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  /// Trimmed and lowercased, like Guest.email.
  email     String
  issueType SupportIssueType     @map("issue_type")
  /// Plain text; empty when the sender chose not to add one (required for OTHER).
  message   String
  status    SupportRequestStatus @default(OPEN)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("invitation_support_requests")
}

// --- Admin accounts (Better Auth) ---
model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  username        String?   @unique
  displayUsername String?   @map("display_username")
  /// "admin" or "check_in" (lib/roles.ts). Set by Better Auth's admin plugin; never by the user.
  role            String    @default("check_in")
  /// A disabled account: it can't sign in, and its sessions were deleted when it was disabled.
  banned          Boolean   @default(false)
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  checkIns        Guest[]   @relation("CheckedInBy")

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}
