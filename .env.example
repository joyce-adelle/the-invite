# Copy to .env and fill in. All values are server-only — never prefix with NEXT_PUBLIC_.

# --- Admin sign-in (Better Auth) ---
# Signs session cookies.
BETTER_AUTH_SECRET=secret

# The public origin of the site. Use https:// in production so cookies are Secure.
# Also the address the QR codes on access cards open (<this>/check-in/<token>), so it
# must be the address guests' phones can reach. Changing it only affects cards made afterwards.
BETTER_AUTH_URL=http://localhost:3000

# --- Super admin (used by the seeds, or alone with `npm run db:seed:admin`) ---
# Staff sign in with a username and password, stored in the database. There is no sign-up:
# the seed creates this account as a super admin, who can then add admins (and any admin can
# add check-in users) in the app (Staff accounts). Username: 3-30 letters, numbers, underscores
# or dots (not case sensitive). Password: at least 8 characters.
# A super admin is the only one who can change table settings, manage hosts and manage admins,
# and nobody can disable, reset or demote one from the app. That's stored as a role in the
# database, so these only need to be set when seeding.
# Run the seed again with a new ADMIN_PASSWORD to change its password (it is signed out
# everywhere), or with another ADMIN_USERNAME to make that admin a super admin too (an existing
# ordinary admin is promoted; a disabled one is re-enabled).
ADMIN_USERNAME=admin
ADMIN_PASSWORD="choose-a-long-password"
# Optional. Better Auth needs an address on every account; nothing is ever sent to it.
# Defaults to <username>@admin.invalid>.
ADMIN_EMAIL=username>@admin.invalid

# --- Resend (access-card emails) ---
RESEND_API_KEY=key
# Must be on a domain verified in Resend.
EMAIL_FROM="TheInvite <invites@example.com>"

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/the_invite"