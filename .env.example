# Copy to .env and fill in. All values are server-only — never prefix with NEXT_PUBLIC_.

# --- Admin sign-in (Better Auth) ---
# Signs and encrypts session cookies.
BETTER_AUTH_SECRET=secret

# The public origin of the site. Use https:// in production so cookies are Secure.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of emails allowed into the admin panel.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Hash of the one password every admin shares. Create it with: npm run auth:hash-password
# Rotate the password by replacing this value and restarting; sessions signed in
# with the old password stop working. Keep the quotes.
ADMIN_PASSWORD_HASH="salt:hash"

# --- Resend (access-card emails) ---
RESEND_API_KEY=key
# Must be on a domain verified in Resend.
EMAIL_FROM="TheInvite <invites@example.com>"

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/the_invite"