# Copy to .env.local and fill in. All values are server-only — never prefix with NEXT_PUBLIC_.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Comma-separated list of emails allowed into the admin panel.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# --- Resend (magic-link + access-card emails) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="TheInvite <invites@example.com>"

# --- Google Sheets (guest data store) ---
# Service account with Editor access to the spreadsheet (share the sheet with this email).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service-account JSON; keep the \n escapes and the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from the spreadsheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
