# Copy to .env.local and fill in. All values are server-only — never prefix with NEXT_PUBLIC_.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Comma-separated list of emails allowed into the admin panel.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# --- Resend (magic-link + access-card emails) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="TheInvite <invites@example.com>"

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/the_invite"